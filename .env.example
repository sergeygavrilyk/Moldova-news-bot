# Шаблон змінних середовища для Moldova News Bot.
# Скопіюйте у файл .env (він у .gitignore) і заповніть значення.
# У GitHub Actions ті самі назви задаються в Settings -> Secrets and variables -> Actions.

# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Канал для публікацій: @username або числовий ID виду -100xxxxxxxxxx (бот має бути адміністратором)
TELEGRAM_CHANNEL_ID=-1001234567890

# (необов'язково) Чат для звітів після кожного запуску та алертів про падіння
ADMIN_CHAT_ID=123456789

# Ключ Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Supabase -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
